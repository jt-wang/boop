<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode's App Store export rewrites this to `production` from the distribution profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- [compliance] Universal links to interfaces (App Review 4.7.4): the host serves /.well-known/apple-app-site-association
	     for /open/*. DEEPSEEK_BOT_LINK_DOMAIN in project.yml is the host's domain. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(DEEPSEEK_BOT_LINK_DOMAIN)</string>
	</array>
</dict>
</plist>
